# Copy to .env.local in apps/pro-edition (or the repo root for local Supabase CLI use).
# Never commit the real values.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — bypasses Row Level Security. Used in admin server actions and
# route handlers that need elevated access (e.g. promoting a user to admin).
# NEVER expose this to client code or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Local dev admin login created by supabase/seed.sql.
SEED_ADMIN_EMAIL=admin@bytescope.test
SEED_ADMIN_PASSWORD=bytescope-admin
